{
  "name": "x-sage",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-native concept knowledge graph",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter='@x-sage/*' build",
    "dev": "bun run --filter @x-sage/server dev",
    "server": "bun run --filter @x-sage/server dev",
    "cli": "bun run --filter @x-sage/cli dev",
    "viz": "bun run --filter @x-sage/viz dev",
    "typecheck": "bun run --filter='@x-sage/*' typecheck",
    "validate": "bun run --filter @x-sage/cli validate",
    "test": "bun test",
    "ci": "./scripts/ci.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.5"
  }
}
