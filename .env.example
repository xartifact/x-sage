# 部署相关环境变量。复制为 .env 后按需修改。
# .env 不入库（见 .gitignore）。

# 镜像标签：main 分支部署 latest，其他分支部署 alpha。
IMAGE_TAG=latest

# 宿主机映射端口。x99 上 3000/3200/5005/8787 已被占用，默认取 3001。
HOST_PORT=3001

# 写操作令牌。客户端用 `--token` 或 X_SAGE_TOKEN 提交；不设则容器拒绝启动。
# 生成：openssl rand -hex 32
X_SAGE_WRITE_TOKEN=

# 以下三项通常只在本地 `docker compose build` 时有用；CI 会通过 build-args 传入。
# 留空即可，不要用来覆盖镜像内已固化的版本信息。
# APP_VERSION=
# GIT_COMMIT_HASH=
# BUILD_REF=
